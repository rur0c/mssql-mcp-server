@@ -0,0 +1,74 @@
+import sql from "mssql";
+export class ExecuteDdlTool {
+    constructor() {
+        this.name = "execute_ddl";
+        this.description = "Executes a DDL statement (CREATE VIEW, ALTER TABLE, etc.) against a specific schema. Only allowed on schemas permitted by the environment's allowedSchemas policy. The tableName parameter must be set to 'schema.objectName' so that schema enforcement can verify access.";
+        this.inputSchema = {
+            type: "object",
+            properties: {
+                tableName: {
+                    type: "string",
+                    description: "Schema-qualified object name for schema enforcement (e.g., 'staging.MyView'). Must match the schema used in the SQL statement."
+                },
+                sql: {
+                    type: "string",
+                    description: "The DDL SQL statement to execute (e.g., CREATE VIEW, ALTER TABLE, CREATE FUNCTION). Must not contain INSERT/UPDATE/DELETE/DROP/TRUNCATE."
+                },
+                environment: {
+                    type: "string",
+                    description: "Optional environment name to target.",
+                },
+            },
+            required: ["tableName", "sql"],
+        };
+    }
+    async run(params) {
+        try {
+            const { tableName, sql: ddlSql } = params;
+            // Validate tableName has a schema prefix
+            if (!tableName || !tableName.includes('.')) {
+                return {
+                    success: false,
+                    message: "tableName must be schema-qualified (e.g., 'staging.MyView') for schema enforcement.",
+                    error: "INVALID_TABLE_NAME",
+                };
+            }
+            const normalised = ddlSql.trim().toUpperCase();
+            // Block destructive DML — only allow DDL
+            const blocked = ["INSERT ", "UPDATE ", "DELETE ", "DROP ", "TRUNCATE ", "EXEC ", "EXECUTE "];
+            for (const keyword of blocked) {
+                if (normalised.startsWith(keyword)) {
+                    return {
+                        success: false,
+                        message: `execute_ddl does not allow ${keyword.trim()} statements. Use the dedicated tools for data operations.`,
+                        error: "DDL_ONLY",
+                    };
+                }
+            }
+            // Only allow CREATE / ALTER statements
+            const allowed = ["CREATE ", "ALTER "];
+            const isAllowed = allowed.some((kw) => normalised.startsWith(kw));
+            if (!isAllowed) {
+                return {
+                    success: false,
+                    message: `execute_ddl only allows CREATE and ALTER statements. Got: ${normalised.substring(0, 30)}...`,
+                    error: "DDL_ONLY",
+                };
+            }
+            const request = new sql.Request(params.pool);
+            await request.query(ddlSql);
+            return {
+                success: true,
+                message: `DDL executed successfully for '${tableName}'.`,
+            };
+        }
+        catch (error) {
+            console.error("Error executing DDL:", error);
+            return {
+                success: false,
+                message: `Failed to execute DDL: ${error}`,
+            };
+        }
+    }
+}
